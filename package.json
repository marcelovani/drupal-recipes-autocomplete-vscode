{
  "name": "drupal-recipes-autocomplete-vscode",
  "displayName": "Drupal Recipes Autocomplete for VS Code",
  "description": "Autocomplete for Drupal Recipes",
  "icon": "docs/icon.png",
  "publisher": "marcelovani",
  "author": "Marcelo Vani",
  "version": "1.1.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "repository": {
    "url": "https://github.com/marcelovani/drupal-recipes-autocomplete-vscode.git",
    "type": "git"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "Drupal",
    "Recipe",
    "Autocomplete"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "yaml",
        "aliases": [
          "YAML",
          "yaml"
        ],
        "extensions": [
          ".yaml",
          ".yml"
        ]
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "recipe.yml",
          "recipe.yaml"
        ],
        "url": "https://raw.githubusercontent.com/SchemaStore/schemastore/refs/heads/master/src/schemas/json/drupal-recipe.json",
        "$fork": "https://raw.githubusercontent.com/marcelovani/schemastore/refs/heads/drupal-recipes/src/schemas/json/drupal-recipe.json",
        "$url": "file:///Users/marcelo.vani/Development/Projects/Recipes/schemastore/src/schemas/json/drupal-recipe.json"
      }
    ],
    "configuration": {},
    "viewsContainers": {},
    "views": {}
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "publish": "vsce publish ${version}",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "npm run test:unit && npm run test:integration",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.unit.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "NODE_OPTIONS='--no-warnings' vscode-test",
    "verify:package": "node scripts/check-package-contents.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.9",
    "@types/node": "^26.4.0",
    "@types/vscode": "~1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "webpack": "^5.96.1",
    "webpack-cli": "^7.2.2"
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "release-it": {
    "plugins": {
      "@release-it-plugins/lerna-changelog": {
        "infile": "CHANGELOG.md",
        "launchEditor": false
      }
    },
    "git": {
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "tokenRef": "GITHUB_AUTH"
    }
  }
}
